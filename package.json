{
  "name": "dsh-plot-clone",
  "version": "2.10.2",
  "description": "参考图复刻成 Origin 图的 SOP（技能）+ 插件壳：Origin MCP server 随包分发（MIT），装插件即连上，不下载、不注册 connector；缺依赖时首启建 venv，面板显示进度与可复制的手动命令。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/index.js",
    "lib/templates.js",
    "lib/user_templates.js",
    "lib/page.js",
    "lib/client.js",
    "lib/bootstrap.py",
    "make_user_template.mjs",
    "cordis.patch.yml",
    "README.md",
    "test/selftest.mjs",
    "test/patch_check.mjs",
    "test/origin_idle_test.py",
    "test/origin_idle_live_test.py",
    "test/origin_dialogs_test.py",
    "scripts/vendor_sync.mjs",
    "templates/",
    "server/",
    ".gitignore"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "origin",
    "plot",
    "replicate",
    "mcp"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "sidebarRightTabs",
        "sidebarRight",
        "sessions"
      ]
    }
  },
  "scripts": {
    "test": "node test/selftest.mjs",
    "test:patch": "node test/patch_check.mjs",
    "vendor:diff": "node scripts/vendor_sync.mjs"
  }
}
